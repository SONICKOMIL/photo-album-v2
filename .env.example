# ============================================================
# Livara Environment Variables
# ============================================================
# Copy this file to `.env` at the repository root (recommended),
# and/or to `apps/api/.env` and `apps/worker/.env`.
#
# Never commit real secrets.
# ============================================================


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

NODE_ENV=development

WEB_PORT=3000
API_PORT=3001


# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------
# Matches local Docker Compose defaults from compose.yaml.
# Override POSTGRES_PASSWORD in your shell/compose env for a
# non-default local password if desired.

DATABASE_URL=postgresql://livara:livara@localhost:5432/livara


# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------

REDIS_URL=redis://localhost:6379


# ------------------------------------------------------------
# Cloudflare R2
# ------------------------------------------------------------
# Optional for local startup. Leave empty to skip R2 verification.
# Provide all five values together when testing real R2 access.
#
# Endpoint example:
# https://<accountid>.r2.cloudflarestorage.com

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=


# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------
# Reserved for later phases. Leave empty for Phase 2.

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=


# ------------------------------------------------------------
# Frontend
# ------------------------------------------------------------

NEXT_PUBLIC_API_URL=http://localhost:3001


# ------------------------------------------------------------
# Manual MVP (temporary — see docs/MVP_MANUAL_OPERATIONS.md)
# ------------------------------------------------------------
# These variables power the temporary manual operational mode.
# They will be removed when Prisma (Phase 3), authentication
# (Phase 5+) and R2 direct upload (Phase 11) are implemented.
#
# MVP_DATA_DIR / MVP_UPLOAD_DIR are resolved relative to the
# repository root when not absolute. Both are gitignored.
#
# MVP_OPERATOR_KEY protects the internal operator endpoints used
# by the operator CLI. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Operator endpoints stay disabled while this value is empty.

MVP_DATA_DIR=data/mvp
MVP_UPLOAD_DIR=data/mvp/uploads
MVP_OPERATOR_KEY=
MVP_PUBLIC_WEB_URL=http://localhost:3000
