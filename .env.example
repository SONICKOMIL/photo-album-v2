# ============================================================
# Livara Environment Variables
# ============================================================
# Copy this file to `.env` at the repository root (recommended),
# and/or to `apps/api/.env` and `apps/worker/.env`.
#
# Never commit real secrets.
# ============================================================


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

NODE_ENV=development

WEB_PORT=3000
API_PORT=3001


# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------
# Matches local Docker Compose defaults from compose.yaml.
# Override POSTGRES_PASSWORD in your shell/compose env for a
# non-default local password if desired.

DATABASE_URL=postgresql://livara:livara@localhost:5432/livara


# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------

REDIS_URL=redis://localhost:6379


# ------------------------------------------------------------
# Cloudflare R2
# ------------------------------------------------------------
# Optional for local startup. Leave empty to skip R2 verification.
# Provide all five values together when testing real R2 access.
#
# Endpoint example:
# https://<accountid>.r2.cloudflarestorage.com

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=


# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------
# Reserved for later phases. Leave empty for Phase 2.

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=


# ------------------------------------------------------------
# Frontend
# ------------------------------------------------------------

NEXT_PUBLIC_API_URL=http://localhost:3001
